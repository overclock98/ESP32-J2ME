
# Cache config
CONFIG_ESP32S3_INSTRUCTION_CACHE_16KB=y
CONFIG_ESP32S3_DATA_CACHE_16KB=y
CONFIG_ESP32S3_KEEP_USB_ALIVE=y

# USB
CONFIG_ESP_CONSOLE_USB_CDC=y

# Flash
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPI_FLASH_UNDER_HIGH_FREQ=y

# ESP PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Route ALL malloc to PSRAM (8MB) instead of the scarce ~512KB internal RAM. Default
# ALWAYSINTERNAL=16384 forced every <16KB alloc internal → the game's many small objects
# exhausted internal RAM and crashed in tlsf. Keep a small internal reserve for DMA/ISR.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# Touch
CONFIG_TOUCH_SUPPRESS_DEPRECATE_WARN=y
# Touch uses the NEW i2c_master driver; flint.io still links the LEGACY i2c driver. Skip the
# legacy driver's boot-time conflict abort — they never drive the same port at runtime.
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y
